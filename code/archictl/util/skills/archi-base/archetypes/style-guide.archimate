  <folder name="Strategy" id="id-29fa0519c307488791ed50033830a861" type="strategy">
    <element xsi:type="archimate:Capability" name="Capability" id="id-a66556a5399f4cf1994ee95514a18c09"/>
    <element xsi:type="archimate:Capability" name="Container Images Management" id="id-dbe0790c0fec474486c6765c0bb1cfca"/>
    <element xsi:type="archimate:Capability" name="Software Defined Virtual Infrastructure" id="id-f896997d71c2478581ddfb30d9c23ba2"/>
    <element xsi:type="archimate:Capability" name="Resource Lifecycle Management" id="id-sg-r3-cap-rg-000001">
      <documentation>Capability to create, configure and manage the lifecycle of scoped resource containers, including cascade delete, RBAC boundary enforcement and policy evaluation.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Network Attachment and Addressing" id="id-sg-r4-cap-nic-000001">
      <documentation>Capability to attach compute nodes to networks and expose them via addressable interfaces (NICs, public IPs).</documentation>
    </element>
  </folder>
  <folder name="Business" id="id-3c8140e76c3549b5857bb931b63b27c7" type="business"/>
  <folder name="Application" id="id-78a341bf82a84948af6a9b500bddc25a" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Application Component" id="id-250103237b87440785fba6484330bdc0"/>
    <element xsi:type="archimate:ApplicationService" name="Application Service" id="id-77b7dc9a541a4b829f8431da128f7a25"/>
    <element xsi:type="archimate:ApplicationComponent" name="Solution Container Registry Component" id="id-daa78b2303f74bccb2b4c237e1f003ef">
      <documentation>Instance of Azure Container Registry created and managed for the solution at hand</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Solution Container Registry  Service" id="id-5d25f742600541948290657181b8c789"/>
    <element xsi:type="archimate:ApplicationComponent" name="Software Defined Solution Component" id="id-6680becda6b04ff5b7d0b405eac50d31"/>
    <element xsi:type="archimate:ApplicationService" name="Software Defined Solution Service" id="id-28a374e2e5f546abb9c2887b7a78a5a8"/>
    <element xsi:type="archimate:ApplicationService" name="Solution LB" id="id-f06c6f3b40564fd397b0501a87e59d47"/>
    <element xsi:type="archimate:ApplicationService" name="Solution VNET" id="id-13d1147e13f542d59a01fab8f6328bc2"/>
    <element xsi:type="archimate:ApplicationService" name="Solution VM" id="id-0a0428b7019944d0a84d5008b8aed548"/>
    <element xsi:type="archimate:ApplicationService" name="Solution Subnet" id="id-2857e5c3a9ae4b148ddbdceb55c234d2"/>
    <element xsi:type="archimate:ApplicationComponent" name="Solution Resource Group" id="id-sg-r3-app-rg-generic-00001">
      <documentation>Generic archetype for a solution-managed Azure Resource Group instance. The team names, provisions and owns this instance. Specializations represent specific RGs (Delivery, Fulfillment, Key Vault, etc.).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Solution Delivery Resource Group" id="id-sg-r3-app-rg-delivery-00002">
      <documentation>Example: specific Resource Group for Service Delivery resources. Team responsibility: provisioned by Security Team, contains Delivery infrastructure.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Resource Container Service" id="id-sg-r3-app-rgsvc-00003">
      <documentation>Application-level service exposed by the resource group: scoped access boundary, lifecycle management boundary, billing boundary.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Solution VMSS Based Component" id="id-651f64c793f647708eb980fd64f4c534"/>
    <element xsi:type="archimate:ApplicationService" name="Solution VMSS Based Service" id="id-480a8a11c4704a6f9559de00c3623959"/>
  </folder>
  <folder name="Technology &amp; Physical" id="id-a7881d23b679406da29e641e33c9b12c" type="technology">
    <element xsi:type="archimate:TechnologyService" name="Technology Service" id="id-4f20b1364b5a47f9968ed2bd5796a44c"/>
    <element xsi:type="archimate:TechnologyService" name="Azure Container Registry" id="id-2c818830e9394ebba8f67ca0cdba8be1">
      <documentation>Technology Managed Service Offered By Microsoft Azure
</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Software Defined Infrastructure Managed Virtual Service Component" id="id-720d3c5e20cd40f9b3cea10b4ab51eef"/>
    <element xsi:type="archimate:CommunicationNetwork" name="Software Defined Network" id="id-e5fbb2417f734450b6d5aded02dde8d3"/>
    <element xsi:type="archimate:Node" name="Software Defined Node" id="id-02ce829d995e4b4f8003ade233a7f4af"/>
    <element xsi:type="archimate:Node" name="Solution VM" id="id-bc3c9abb5c914db2a6d1f46b97979d5a"/>
    <element xsi:type="archimate:Node" name="Solution LB" id="id-7f6fa243f2a34e5b99c7d85aca1ae930"/>
    <element xsi:type="archimate:CommunicationNetwork" name="Solution VNET" id="id-8caec5f4df1849858a68f7c576a3e0e3"/>
    <element xsi:type="archimate:CommunicationNetwork" name="Solution Subnet" id="id-9b8804b1bec3478ead72276561fcccd9"/>
    <element xsi:type="archimate:TechnologyService" name="Azure Resource Group" id="id-sg-r3-tech-rgsvc-00001">
      <documentation>Microsoft Azure ARM Resource Group platform capability (provider responsibility).
Behaviour: cascade delete of all contained resources, RBAC scope boundary, Azure Policy evaluation scope, regional affinity enforcement.
This is what the organisation buys — the platform feature. Specific instances are ApplicationComponents.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Azure Virtual NIC Service" id="id-sg-r4-tech-nicsvc-00001">
      <documentation>Microsoft Azure virtual NIC platform capability (provider responsibility).
Provides virtual network interface cards and public IP allocation as a managed service.
Specific NIC and IP instances are TechnologyInterfaces composed within their parent VM Node.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyInterface" name="Technology Interface" id="id-sg-r4-tech-iface-generic-00001">
      <documentation>Generic archetype for a technology interface — an access point through which a technology service is made available (ArchiMate §11.3).</documentation>
    </element>
    <element xsi:type="archimate:TechnologyInterface" name="Solution VM NIC" id="id-sg-r4-tech-iface-nic-00002">
      <documentation>Example: NIC attached to Solution VM. Access point connecting the VM Node to its subnet.
Azure Resource Type: Microsoft.Network/networkInterfaces
Composed within: Solution VM (parent Node)
Associated to: Solution Subnet (CommunicationNetwork)</documentation>
    </element>
    <element xsi:type="archimate:TechnologyInterface" name="Solution Public IP" id="id-sg-r4-tech-iface-pip-00003">
      <documentation>Example: Public IP address bound to Solution VM NIC. External-facing address through which the VM service is reachable.
Azure Resource Type: Microsoft.Network/publicIPAddresses
Associated to: Solution VM NIC (TechnologyInterface)</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Azure Virtual Machines Scale Set" id="id-b6c6c571f8654f5cbf52c650c592833b">
      <documentation>Azure Virtual Machines Scale Set (Technology Service)</documentation>
    </element>
    <element xsi:type="archimate:TechnologyCollaboration" name="Azure Virtual Machine Scale Set" id="id-eef233fa248a4a3eb7fd1e544471b668"/>
    <element xsi:type="archimate:Node" name="Azure VMSS VM 1" id="id-15101b7f99144e87be1975a201ff7eb2"/>
    <element xsi:type="archimate:Node" name="Azure VMSS VM 2" id="id-29cd698a93b1440c9eeaaf083a9b78f3"/>
    <element xsi:type="archimate:SystemSoftware" name="Azure Control Plane - VMSS Driving Software" id="id-76487204687b49cfbcbe1d2a74aa7c0c">
      <documentation>This component, encapsulated somewhere in Azure and transparent to the user, implements the behavior managing the number of nodes, rules evaluation and triggering and so on.</documentation>
    </element>
  </folder>
