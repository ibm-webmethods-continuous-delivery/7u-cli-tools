<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="IBMIntegrationReference" id="id-ibm-model-root" version="5.0.0">
  <folder name="Strategy" id="f1" type="strategy">
    <element xsi:type="archimate:Capability" name="Enterprise Transactional Messaging" id="id-ibm-cap-mq-01"/>
    <element xsi:type="archimate:Capability" name="Hybrid Application &amp; Protocol Integration" id="id-ibm-cap-ace-01"/>
    <element xsi:type="archimate:Capability" name="API Governance &amp; Security Gateway" id="id-ibm-cap-apic-01"/>
  </folder>
  <folder name="Business" id="f2" type="business"/>
  <folder name="Application" id="f3" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Core Payment IBM MQ Queue Manager" id="id-ibm-app-mq-qmgr-01">
      <documentation>Queue Manager holding secure transactional request and reply queues.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Payment Transformation ACE Flow" id="id-ibm-app-ace-flow-01">
      <documentation>App Connect Enterprise message flow performing ISO20022 transformation and validation.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Corporate Payment Managed API" id="id-ibm-app-apic-api-01">
      <documentation>API Connect published REST API enforcing OAuth2 and rate limits.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Payment Request Queue Service" id="id-ibm-app-mq-req-svc-01"/>
    <element xsi:type="archimate:ApplicationService" name="Payment Validation &amp; Routing Service" id="id-ibm-app-ace-svc-01"/>
    <element xsi:type="archimate:ApplicationService" name="Payment REST Endpoint Service" id="id-ibm-app-apic-svc-01"/>
  </folder>
  <folder name="Technology &amp; Physical" id="f4" type="technology">
    <element xsi:type="archimate:Node" name="CP4I OpenShift Cluster" id="id-ibm-tech-ocp-node-01"/>
    <element xsi:type="archimate:SystemSoftware" name="IBM MQ Runtime Operator" id="id-ibm-tech-mq-runtime-01"/>
    <element xsi:type="archimate:SystemSoftware" name="IBM App Connect Integration Server Runtime" id="id-ibm-tech-ace-runtime-01"/>
    <element xsi:type="archimate:SystemSoftware" name="IBM DataPower / APIC Gateway Engine" id="id-ibm-tech-apic-runtime-01"/>
  </folder>
  <folder name="Motivation" id="f5" type="motivation"/>
  <folder name="Implementation &amp; Migration" id="f6" type="implementation_migration"/>
  <folder name="Other" id="f7" type="other"/>
  <folder name="Relations" id="f8" type="relations">
