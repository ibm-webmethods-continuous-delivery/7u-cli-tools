    <element xsi:type="archimate:RealizationRelationship" id="id-wm-rel-api-realizes-svc" source="id-wm-app-api-01" target="id-wm-app-api-svc-01"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-wm-rel-um-realizes-svc" source="id-wm-app-um-realm-01" target="id-wm-app-um-svc-01"/>
    <element xsi:type="archimate:CompositionRelationship" id="id-wm-rel-ocp-comp-is" source="id-wm-tech-ocp-node-01" target="id-wm-tech-is-runtime-01"/>
    <element xsi:type="archimate:CompositionRelationship" id="id-wm-rel-ocp-comp-msr" source="id-wm-tech-ocp-node-01" target="id-wm-tech-msr-runtime-01"/>
    <element xsi:type="archimate:CompositionRelationship" id="id-wm-rel-ocp-comp-agw" source="id-wm-tech-ocp-node-01" target="id-wm-tech-agw-runtime-01"/>
    <element xsi:type="archimate:CompositionRelationship" id="id-wm-rel-is-comp-pkg" source="id-wm-app-is-01" target="id-wm-app-is-pkg-01"/>
    <element xsi:type="archimate:ServingRelationship" id="id-wm-rel-is-serves-inst" source="id-wm-tech-is-runtime-01" target="id-wm-app-is-01"/>
    <element xsi:type="archimate:ServingRelationship" id="id-wm-rel-msr-serves-inst" source="id-wm-tech-msr-runtime-01" target="id-wm-app-msr-01"/>
    <element xsi:type="archimate:ServingRelationship" id="id-wm-rel-agw-serves-inst" source="id-wm-tech-agw-runtime-01" target="id-wm-app-agw-01"/>
    <element xsi:type="archimate:ServingRelationship" id="id-wm-rel-mft-serves-inst" source="id-wm-tech-mft-runtime-01" target="id-wm-app-mft-01"/>
    <element xsi:type="archimate:ServingRelationship" id="id-wm-rel-agw-serves-api" source="id-wm-app-api-svc-01" target="id-wm-app-is-01"/>
    <element xsi:type="archimate:ServingRelationship" id="id-wm-rel-is-serves-um" source="id-wm-app-is-svc-01" target="id-wm-app-um-realm-01"/>
  </folder>
  <folder name="Views" id="f9" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" name="wM-IS-MSR-on-Kubernetes" id="id-wm-diag-ocp-01">
      <child xsi:type="archimate:DiagramObject" id="d1" archimateElement="id-wm-tech-ocp-node-01">
