<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="webMethodsPatterns" id="id-wm-model-root" version="5.0.0">
  <folder name="Strategy" id="f1" type="strategy">
    <element xsi:type="archimate:Capability" name="Application &amp; Protocol Integration" id="id-wm-cap-is-01"/>
    <element xsi:type="archimate:Capability" name="Managed File Transfer" id="id-wm-cap-mft-01"/>
    <element xsi:type="archimate:Capability" name="API Management" id="id-wm-cap-agw-01"/>
    <element xsi:type="archimate:Capability" name="Pub-Sub Messaging" id="id-wm-cap-um-01"/>
  </folder>
  <folder name="Business" id="f2" type="business"/>
  <folder name="Application" id="f3" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Integration Server Instance" id="id-wm-app-is-01">
      <documentation>webMethods Integration Server runtime instance hosting IS packages and flow services.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Microservices Runtime Instance" id="id-wm-app-msr-01">
      <documentation>Lightweight IS variant. Container-native, single-package, stateless.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="IS Package" id="id-wm-app-is-pkg-01">
      <documentation>Deployment unit containing flow services, adapters, and configuration.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ActiveTransfer Server" id="id-wm-app-mft-01">
      <documentation>webMethods ActiveTransfer server handling managed file transfers.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="ActiveTransfer SaaS" id="id-wm-app-mft-saas-01">
      <documentation>webMethods ActiveTransfer SaaS instance (cloud-hosted MFT endpoint for hybrid transfer).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="API Gateway Instance" id="id-wm-app-agw-01">
      <documentation>webMethods API Gateway instance enforcing policies and routing to backends.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Published API" id="id-wm-app-api-01">
      <documentation>REST or SOAP API published and managed through API Gateway.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Universal Messaging Realm" id="id-wm-app-um-realm-01">
      <documentation>Universal Messaging realm server providing channels and queues.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="IS Flow Service" id="id-wm-app-is-svc-01"/>
    <element xsi:type="archimate:ApplicationService" name="MFT Transfer Service" id="id-wm-app-mft-svc-01"/>
    <element xsi:type="archimate:ApplicationService" name="API Endpoint Service" id="id-wm-app-api-svc-01"/>
    <element xsi:type="archimate:ApplicationService" name="UM Channel Service" id="id-wm-app-um-svc-01"/>
  </folder>
  <folder name="Technology &amp; Physical" id="f4" type="technology">
    <element xsi:type="archimate:Node" name="OpenShift / Kubernetes Cluster" id="id-wm-tech-ocp-node-01"/>
    <element xsi:type="archimate:Node" name="On-Prem Host" id="id-wm-tech-host-01"/>
    <element xsi:type="archimate:SystemSoftware" name="IS Runtime Engine" id="id-wm-tech-is-runtime-01"/>
    <element xsi:type="archimate:SystemSoftware" name="MSR Runtime Engine" id="id-wm-tech-msr-runtime-01"/>
    <element xsi:type="archimate:SystemSoftware" name="ActiveTransfer Runtime" id="id-wm-tech-mft-runtime-01"/>
    <element xsi:type="archimate:SystemSoftware" name="API Gateway Engine" id="id-wm-tech-agw-runtime-01"/>
  </folder>
  <folder name="Motivation" id="f5" type="motivation"/>
  <folder name="Implementation &amp; Migration" id="f6" type="implementation_migration"/>
  <folder name="Other" id="f7" type="other"/>
  <folder name="Relations" id="f8" type="relations">
    <element xsi:type="archimate:RealizationRelationship" id="id-wm-rel-is-realizes-cap" source="id-wm-tech-is-runtime-01" target="id-wm-cap-is-01"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-wm-rel-mft-realizes-cap" source="id-wm-tech-mft-runtime-01" target="id-wm-cap-mft-01"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-wm-rel-agw-realizes-cap" source="id-wm-tech-agw-runtime-01" target="id-wm-cap-agw-01"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-wm-rel-um-realizes-cap" source="id-wm-app-um-realm-01" target="id-wm-cap-um-01"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-wm-rel-is-pkg-realizes-svc" source="id-wm-app-is-pkg-01" target="id-wm-app-is-svc-01"/>
